        "        \"name\": m[\"name\"],\n",
        "        \"size_GB\": round(m[\"size\"]/1e9, 2),\n",
        "        \"family\": m[\"details\"].get(\"family\"),\n",
        "        \"params\": m[\"details\"].get(\"parameter_size\"),\n",
        "        \"quantization\": m[\"details\"].get(\"quantization_level\"),\n",
        "    } for m in tags])\n",
        "\n",
        "def loaded_models():\n",
        "    ps = requests.get(f\"{OLLAMA}/api/ps\").json()[\"models\"]\n",
        "    return pd.DataFrame([{\n",
