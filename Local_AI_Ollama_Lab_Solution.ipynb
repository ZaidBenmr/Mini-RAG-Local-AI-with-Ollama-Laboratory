      "source": [
        "%%writefile local-ai-web/app.py\n",
        "import os\n",
        "from flask import Flask, render_template, request\n",
        "import requests\n",
        "\n",
        "app = Flask(__name__)\n",
        "\n",
        "OLLAMA_URL = \"http://localhost:11434/api/generate\"\n",
        "MODEL = os.environ.get(\"MODEL\", \"qwen3.5:4b\")\n",
        "\n",
        "\n",
        "@app.route(\"/\", methods=[\"GET\", \"POST\"])\n",
        "def index():\n",
        "    answer = \"\"\n",
        "\n",
        "    if request.method == \"POST\":\n",
        "        question = request.form[\"question\"]\n",
        "        data = {\"model\": MODEL, \"prompt\": question, \"stream\": False, \"think\": False}\n",
        "        response = requests.post(OLLAMA_URL, json=data, timeout=900)\n",
        "        if response.status_code == 400 and \"think\" in response.text.lower():\n",
        "            data.pop(\"think\")\n",
        "            response = requests.post(OLLAMA_URL, json=data, timeout=900)\n",
        "        answer = response.json().get(\"response\", response.text)\n",
        "\n",
        "    return render_template(\"index.html\", answer=answer)\n",
        "\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    # port 5050: port 5000 is used by AirPlay Receiver on macOS\n",
        "    app.run(host=\"127.0.0.1\", port=int(os.environ.get(\"PORT\", 5050)), debug=False)"
      ],
