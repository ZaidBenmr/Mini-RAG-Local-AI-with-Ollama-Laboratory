      "source": [
        "import sys\n",
        "\n",
        "def start_server(script_dir, port, log_name):\n",
        "    log_path = os.path.abspath(log_name)            # log kept outside the deliverable folder\n",
        "    log = open(log_path, \"w\")\n",
        "    env = {**os.environ, \"MODEL\": MODEL, \"PORT\": str(port)}\n",
        "    proc = subprocess.Popen([sys.executable, \"app.py\"], cwd=script_dir, env=env, stdout=log, stderr=subprocess.STDOUT)\n",
        "    for _ in range(60):\n",
        "        try:\n",
        "            requests.get(f\"http://127.0.0.1:{port}/\", timeout=2)\n",
        "            print(f\"✅ Server running → http://127.0.0.1:{port}\")\n",
        "            return proc\n",
        "        except requests.exceptions.RequestException:\n",
        "            if proc.poll() is not None:\n",
        "                break\n",
        "            time.sleep(1)\n",
        "    proc.terminate()\n",
        "    raise RuntimeError(f\"Server did not start, see {log_path}:\\n\" + open(log_path).read())\n",
        "\n",
        "web = start_server(\"local-ai-web\", 5050, \"webapp_server.log\")\n",
        "r = requests.post(\"http://127.0.0.1:5050/\", data={\"question\": \"What is a local LLM? Answer in two sentences.\"}, timeout=900)\n",
        "answer_html = re.search(r\"<pre[^>]*>(.*?)</pre>\", r.text, re.DOTALL)\n",
        "print(\"Web app answer:\", answer_html.group(1).strip()[:400] if answer_html else r.text[:400])"
      ],
