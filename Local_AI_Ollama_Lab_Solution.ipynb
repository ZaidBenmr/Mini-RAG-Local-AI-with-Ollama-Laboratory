      "source": [
        "import os, time, json, shutil, subprocess\n",
        "import requests\n",
        "\n",
        "OLLAMA = \"http://localhost:11434\"\n",
        "\n",
        "def ollama_up():\n",
        "    try:\n",
        "        return requests.get(OLLAMA, timeout=3).ok\n",
        "    except requests.exceptions.RequestException:\n",
        "        return False\n",
        "\n",
        "if not ollama_up():\n",
        "    exe = shutil.which(\"ollama\")\n",
        "    if exe:\n",
        "        print(\"Ollama not running, starting `ollama serve` in the background...\")\n",
        "        subprocess.Popen([exe, \"serve\"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\n",
        "        for _ in range(30):\n",
        "            time.sleep(1)\n",
        "            if ollama_up():\n",
        "                break\n",
        "\n",
        "if ollama_up():\n",
        "    print(\"✅ Ollama server reachable:\", requests.get(OLLAMA).text)\n",
        "else:\n",
        "    raise RuntimeError(\"❌ Ollama is not running. Install it from https://ollama.com/download, \"\n",
        "                       \"or run `ollama serve` in a terminal, then re-run this cell.\")"
      ],
