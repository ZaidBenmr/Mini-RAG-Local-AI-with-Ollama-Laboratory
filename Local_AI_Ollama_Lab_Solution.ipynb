        "        \"expires_at\": m.get(\"expires_at\"),\n",
        "    } for m in ps])\n",
        "\n",
        "print(\"Downloaded:\"); display(downloaded_models())\n",
        "print(\"Currently loaded in memory:\"); display(loaded_models())"
