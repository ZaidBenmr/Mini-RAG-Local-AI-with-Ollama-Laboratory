      "source": [
        "prime_prompt = \"\"\"Write a Python function that determines whether a number is prime.\n",
        "\n",
        "Requirements:\n",
        "- Python\n",
        "- Type hints\n",
        "- Docstring\n",
        "- Explain the algorithm\n",
        "- Give its time complexity\"\"\"\n",
