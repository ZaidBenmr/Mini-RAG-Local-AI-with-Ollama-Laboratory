        "id": "c013"
      },
      "source": [
        "### Exercise 4 — Run the model\n",
        "In the terminal you would use `ollama run qwen3.5:4b`. Here we do the same thing through the API with a helper function.\n",
        "\n",
        "`think=False` turns off the long hidden reasoning of \"thinking\" models (much faster). If a model does not support the option, the helper retries without it."
      ]
    },
    {
      "cell_type": "code",
      "id": "c014",
      "metadata": {
        "id": "c014"
      },
      "source": [
        "def post_ollama(endpoint, payload, timeout=900):\n",
        "    \"\"\"POST to the Ollama API. If the model rejects the 'think' option, retry without it.\"\"\"\n",
        "    r = requests.post(f\"{OLLAMA}{endpoint}\", json=payload, timeout=timeout)\n",
        "    if r.status_code == 400 and \"think\" in payload and \"think\" in r.text.lower():\n",
        "        payload = {k: v for k, v in payload.items() if k != \"think\"}\n",
        "        r = requests.post(f\"{OLLAMA}{endpoint}\", json=payload, timeout=timeout)\n",
        "    r.raise_for_status()\n",
        "    return r.json()\n",
        "\n",
        "def generate(prompt, model=None, system=None, fmt=None, images=None, options=None, think=False):\n",
        "    \"\"\"Call Ollama /api/generate (non-streaming) and return the full JSON dict\n",
        "    plus the measured wall-clock time under the key 'wall_s'.\"\"\"\n",
        "    payload = {\"model\": model or MODEL, \"prompt\": prompt, \"stream\": False}\n",
        "    if system:  payload[\"system\"] = system\n",
        "    if fmt:     payload[\"format\"] = fmt          # \"json\" or a JSON schema\n",
        "    if images:  payload[\"images\"] = images       # list of base64 strings\n",
        "    if options: payload[\"options\"] = options\n",
        "    if think is not None: payload[\"think\"] = think  # False disables 'thinking' on reasoning models\n",
        "    t0 = time.perf_counter()\n",
        "    out = post_ollama(\"/api/generate\", payload)\n",
        "    out[\"wall_s\"] = time.perf_counter() - t0\n",
        "    return out\n",
        "\n",
        "def ask(prompt, **kw):\n",
        "    \"\"\"Shortcut: return only the text, and print timing.\"\"\"\n",
        "    out = generate(prompt, **kw)\n",
        "    print(f\"[{out['wall_s']:.1f}s]\")\n",
        "    return out[\"response\"]"
      ],
      "execution_count": 9,
      "outputs": []
    },
