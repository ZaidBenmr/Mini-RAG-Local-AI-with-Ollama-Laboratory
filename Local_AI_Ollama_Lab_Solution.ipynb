      "source": [
        "**Automatic evaluation.** Instead of typing scores by hand, the next cell:\n",
        "1. extracts the Python code each model wrote and **runs it against a reference implementation** on all numbers from −5 to 1999 → *Code correctness /5*;\n",
        "2. checks the 5 requirements of the prompt (code, type hints, docstring, explanation, complexity) → *Requirements met /5*.\n",
        "\n",
        "(The code runs locally inside this notebook. It comes from your own local model and only defines a function.)"
      ]
    },
    {
      "cell_type": "code",
      "id": "c034",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 147
        },
        "id": "c034",
        "outputId": "f48bfd41-a653-4a23-c238-4d450e895eff"
      },
      "source": [
        "import re, types, io, contextlib\n",
        "\n",
        "def is_prime_reference(n: int) -> bool:\n",
        "    if n < 2: return False\n",
        "    if n < 4: return True\n",
        "    if n % 2 == 0: return False\n",
        "    i = 3\n",
        "    while i * i <= n:\n",
        "        if n % i == 0: return False\n",
        "        i += 2\n",
        "    return True\n",
        "\n",
        "def extract_code(text):\n",
        "    blocks = re.findall(r\"```(?:python|py)?[ \\t]*\\n(.*?)```\", text, re.DOTALL)\n",
        "    return max(blocks, key=len) if blocks else None\n",
        "\n",
        "def evaluate_prime_answer(text):\n",
        "    code = extract_code(text)\n",
        "    checks = {\n",
        "        \"Python code\": code is not None,\n",
        "        \"Type hints\": bool(code and re.search(r\"def \\w+\\([^)]*:\\s*\\w+[^)]*\\)\\s*->\", code)),\n",
        "        \"Docstring\": bool(code and ('\"\"\"' in code or \"'''\" in code)),\n",
        "        \"Algorithm explained\": bool(re.search(r\"algorithm|square root|sqrt|divisib|trial division|6k\", text, re.I)),\n",
        "        \"Time complexity\": \"O(\" in text,\n",
        "    }\n",
        "    pass_rate, fn_name, error = 0.0, None, None\n",
        "    if code:\n",
        "        ns = {\"__name__\": \"llm_candidate\"}\n",
        "        try:\n",
        "            with contextlib.redirect_stdout(io.StringIO()):   # hide the model's example prints\n",
        "                exec(code, ns)\n",
        "            fns = {k: v for k, v in ns.items()\n",
        "                   if isinstance(v, types.FunctionType) and v.__module__ == \"llm_candidate\" and \"prime\" in k.lower()}\n",
        "            if fns:\n",
        "                fn_name = \"is_prime\" if \"is_prime\" in fns else next(iter(fns))\n",
        "                candidate, ok = fns[fn_name], 0\n",
        "                tests = range(-5, 2000)\n",
        "                for n in tests:\n",
        "                    try:\n",
        "                        ok += candidate(n) == is_prime_reference(n)\n",
        "                    except (ValueError, TypeError):\n",
        "                        ok += n < 0          # rejecting negative input is acceptable\n",
        "                pass_rate = ok / len(tests)\n",
        "            else:\n",
        "                error = \"no function with 'prime' in its name\"\n",
        "        except Exception as e:\n",
        "            error = f\"{type(e).__name__}: {e}\"\n",
        "    return {\"function\": fn_name, \"tests passed (%)\": round(100 * pass_rate, 1),\n",
        "            \"Code correctness /5\": round(5 * pass_rate, 1),\n",
        "            \"Requirements met /5\": sum(checks.values()),\n",
        "            \"missing\": \", \".join(k for k, v in checks.items() if not v) or \"-\",\n",
        "            \"error\": error or \"-\"}\n",
        "\n",
        "scores = {m: evaluate_prime_answer(results[m][\"response\"]) for m in (MODEL, MODEL2)}\n",
        "\n",
        "table = pd.DataFrame([\n",
        "    {\"Model\": m, \"Response time (s)\": round(results[m][\"wall_s\"], 1),\n",
        "     \"Tokens\": results[m].get(\"eval_count\"), **scores[m]}\n",
        "    for m in (MODEL, MODEL2)\n",
        "])\n",
        "for m, s in scores.items():\n",
        "    print(f\"{m}: \" + (\"✅ candidate matches the reference on -5..1999\" if s[\"tests passed (%)\"] == 100\n",
        "                      else f\"⚠️ {s['tests passed (%)']}% of tests passed ({s['error']})\"))\n",
        "table"
      ],
