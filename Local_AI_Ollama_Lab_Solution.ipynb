        "## Part 3 — Your First Local LLM\n",
        "### Exercise 3 — Download a model\n",
        "Both models are small instruct models (≈ 3–4 GB) that run on 8–16 GB of RAM. With 16 GB+ RAM or a GPU you can use `qwen3.5:9b`; with less than 8 GB use `qwen3.5:2b` and `gemma3:1b` (note `gemma3:1b` cannot read images)."
      ]
    },
    {
      "cell_type": "code",
      "id": "c011",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "c011",
        "outputId": "6e14a05c-7ed3-4eb6-b769-26b7d424ff7d"
      },
      "source": [
        "# Models used throughout the lab — edit if needed\n",
        "MODEL  = \"qwen3.5:4b\"   # Model 1\n",
        "MODEL2 = \"gemma3:4b\"    # Model 2 (used in the comparison parts; also vision-capable)\n",
        "\n",
        "os.environ[\"MODEL\"] = MODEL   # read by the standalone scripts (app.py, chatbot.py)\n",
        "\n",
        "def pull_model(name):\n",
        "    \"\"\"Download a model through the API, printing progress every 10%.\"\"\"\n",
        "    print(f\"Pulling {name} ...\")\n",
        "    last, shown = None, -10\n",
        "    with requests.post(f\"{OLLAMA}/api/pull\", json={\"model\": name, \"stream\": True}, stream=True, timeout=None) as r:\n",
        "        r.raise_for_status()\n",
        "        for line in r.iter_lines():\n",
        "            if not line:\n",
        "                continue\n",
        "            msg = json.loads(line)\n",
        "            if \"error\" in msg:\n",
        "                raise RuntimeError(f\"Could not pull {name}: {msg['error']}. \"\n",
        "                                   \"Check the name at https://ollama.com/library and edit MODEL / MODEL2.\")\n",
        "            status = msg.get(\"status\", \"\")\n",
        "            if msg.get(\"total\") and msg.get(\"completed\") is not None:\n",
        "                pct = int(100 * msg[\"completed\"] / msg[\"total\"])\n",
        "                if pct >= shown + 10:\n",
        "                    print(f\"  {status}: {pct}%\"); shown = pct\n",
        "            elif status != last:\n",
        "                print(\" \", status); last = status; shown = -10\n",
        "    print(f\"✅ {name} ready\")\n",
        "\n",
        "pull_model(MODEL)"
      ],
      "execution_count": 7,
